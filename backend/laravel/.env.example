APP_NAME=Nexora Group
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Africa/Nairobi
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=nexora_primary
DB_USERNAME=nexora_app
DB_PASSWORD=change-this-local-password

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Nexora Group"

# NexCore AI — disabled until a provider secret and privacy review are in place.
NEXCORE_AI_ENABLED=false
NEXCORE_AI_PROVIDER=openai-compatible
NEXCORE_AI_BASE_URL=https://api.openai.com/v1
NEXCORE_AI_API_KEY=
NEXCORE_AI_MODEL=gpt-4o-mini
NEXCORE_AI_TIMEOUT=30
NEXCORE_AI_MAX_TOKENS=800
