# Copy to .env.nexora-stack and replace every placeholder.
# Use a different long, URL-safe random password for EACH database.
# These values are examples only. Never commit the real environment file.

NEXORA_POSTGRES_USER=nexora_app
NEXORA_POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_NEXORA_DB_SECRET
NEXORA_POSTGRES_DB=nexora
NEXORA_DATABASE_URL=postgresql://nexora_app:REPLACE_WITH_UNIQUE_NEXORA_DB_SECRET@nexora_db:5432/nexora?schema=public

NEXISP_POSTGRES_USER=nexisp_app
NEXISP_POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_NEXISP_DB_SECRET
NEXISP_POSTGRES_DB=nexisp
NEXISP_DATABASE_URL=postgresql://nexisp_app:REPLACE_WITH_UNIQUE_NEXISP_DB_SECRET@nexisp_db:5432/nexisp?schema=public

LOOPZA_POSTGRES_USER=loopza_app
LOOPZA_POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_LOOPZA_DB_SECRET
LOOPZA_POSTGRES_DB=loopza
LOOPZA_DATABASE_URL=postgresql://loopza_app:REPLACE_WITH_UNIQUE_LOOPZA_DB_SECRET@loopza_db:5432/loopza?schema=public

# APIs bind to localhost. Put a TLS reverse proxy in front before remote access.
NEXORA_API_HOST_PORT=3101
NEXISP_API_HOST_PORT=3102
LOOPZA_API_HOST_PORT=3103
