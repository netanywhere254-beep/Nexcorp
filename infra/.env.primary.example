# Copy to infra/.env.primary and replace both passwords with unique long secrets.
APP_NAME=Nexora Group
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_KEY=

MYSQL_DATABASE=nexora_primary
MYSQL_USER=nexora_app
MYSQL_PASSWORD=REPLACE_WITH_LONG_UNIQUE_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_LONG_ROOT_PASSWORD
MYSQL_HOST_PORT=3307
APP_HOST_PORT=8080
LOG_LEVEL=info

# Configure SMTP before using real account verification or password recovery.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Nexora Group"

# Configure each HTTPS OTP provider independently before enabling delivery.
TRACE_FIND_SMS_URL=
TRACE_FIND_SMS_TOKEN=
NEXORA_STAFF_SMS_URL=
NEXORA_STAFF_SMS_TOKEN=
NEXORA_PUBLIC_SMS_URL=
NEXORA_PUBLIC_SMS_TOKEN=
\n# Nexora Group governance staff OTP provider\nNEXORA_GROUP_SMS_URL=\nNEXORA_GROUP_SMS_TOKEN=\n