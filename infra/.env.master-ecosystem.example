# Copy this file to infra/.env.master-ecosystem and replace the secret.
# Use a long, unique, URL-safe random password. Never commit the real env file.

POSTGRES_USER=master_app
POSTGRES_PASSWORD=REPLACE_WITH_LONG_UNIQUE_URL_SAFE_SECRET
POSTGRES_DB=master_ecosystem
DATABASE_URL=postgresql://master_app:REPLACE_WITH_LONG_UNIQUE_URL_SAFE_SECRET@postgres:5432/master_ecosystem?schema=public

POSTGRES_HOST_PORT=5432
BACKEND_HOST_PORT=4000
FRONTEND_HOST_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NODE_ENV=development
