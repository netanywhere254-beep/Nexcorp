# Copy this file to .env.nexisp and replace every placeholder.
# Use unique, long, URL-safe random secrets (letters/numbers/_/- only).
# Never commit the real .env.nexisp file.

POSTGRES_USER=nexisp_app
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_LONG_RANDOM_SECRET
POSTGRES_DB=nexisp

REDIS_PASSWORD=REPLACE_WITH_A_DIFFERENT_UNIQUE_LONG_RANDOM_SECRET

# Keep the credentials here in sync with POSTGRES_PASSWORD and REDIS_PASSWORD.
# Use URL-safe secrets so the connection URLs do not need percent-encoding.
DATABASE_URL=postgresql://nexisp_app:REPLACE_WITH_UNIQUE_LONG_RANDOM_SECRET@postgres:5432/nexisp?schema=public
REDIS_URL=redis://:REPLACE_WITH_A_DIFFERENT_UNIQUE_LONG_RANDOM_SECRET@redis:6379

# API is bound to localhost by default. Use a TLS reverse proxy for public access.
API_BIND_ADDRESS=127.0.0.1
API_HOST_PORT=3000
