{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netpulse.example/schemas/emergency-access-credential.schema.json",
  "title": "NetPulse NEARS Emergency Access Credential",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "credential_id",
    "issuer",
    "key_id",
    "subject",
    "tenant_id",
    "targets",
    "allowed_operations",
    "engagement_id",
    "policy_version",
    "not_before",
    "expires_at",
    "max_session_seconds",
    "issued_at",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "credential_id": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    },
    "issuer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "key_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engineer_id",
        "role"
      ],
      "properties": {
        "engineer_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "firmware_engineer",
            "router_engineer",
            "security_engineer",
            "network_engineer",
            "software_engineer",
            "recovery_engineer",
            "qa_engineer",
            "deployment_engineer"
          ]
        }
      }
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "hardware_fingerprint"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "hardware_fingerprint": {
            "type": "string",
            "minLength": 32,
            "maxLength": 256
          }
        }
      }
    },
    "allowed_operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "read_only_diagnostics",
          "configuration_restore",
          "agent_restart",
          "agent_repair",
          "approved_configuration_change",
          "vendor_recovery_guidance"
        ]
      }
    },
    "engagement_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "not_before": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "max_session_seconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 28800
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "signature": {
      "type": "string",
      "minLength": 32,
      "description": "Detached signature over canonicalised claims, encoded using the format defined by the credential verifier. Never store a signing private key in the credential or CPE image."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "allowed_operations": {
            "contains": {
              "const": "approved_configuration_change"
            }
          }
        }
      },
      "then": {
        "properties": {
          "engagement_id": {
            "minLength": 8
          }
        }
      }
    }
  ]
}
