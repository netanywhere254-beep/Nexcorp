#!/bin/sh /etc/rc.common
# OpenWrt procd service template. Package installation must set ownership,
# permissions and an unprivileged service account before enabling this service.
USE_PROCD=1
START=95
STOP=10

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/netpulse-cpe-agent
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
