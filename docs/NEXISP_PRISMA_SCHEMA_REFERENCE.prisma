// REFERENCE ONLY — NOT THE ACTIVE NEXcorp APPLICATION SCHEMA.
//
// The repository's current architecture decision is Laravel modular monolith + MySQL.
// This file records an alternative Prisma + PostgreSQL design based on the schema
// supplied for NexISP. Do not run Prisma migrate/generate against the application
// until the team explicitly approves a move to Node.js/Prisma + PostgreSQL.
//
// Security and data-integrity improvements in this reference:
// - Decimal money fields instead of Float.
// - Tenant-scoped unique keys and composite foreign keys.
// - Password hashes rather than plaintext passwords.
// - Router credentials are referenced through a secret manager; no router password
//   is stored in this schema.
// - Explicit subscription and transaction statuses.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  domain        String         @unique
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(6)
  users         User[]
  customers     Customer[]
  routers       Router[]
  plans         Plan[]
  subscriptions Subscription[]
  invoices      Invoice[]
  transactions  Transaction[]
  accountingConnections AccountingConnection[]
  accountingSyncRuns AccountingSyncRun[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  role         Role     @default(STAFF)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)
  accountingConnections AccountingConnection[] @relation("AccountingConnectionActor")
  accountingSyncRuns AccountingSyncRun[] @relation("AccountingSyncActor")

  @@unique([id, tenantId])
  @@unique([tenantId, email])
  @@index([tenantId, role])
  @@map("users")
}

enum Role {
  SUPER_ADMIN
  ISP_ADMIN
  STAFF
  SUPPORT
}

model Customer {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @db.Uuid
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerNumber String
  name           String
  phone          String
  email          String?
  status         CustomerStatus  @default(PENDING)
  connectionType ConnectionType
  planId         String?         @db.Uuid
  plan           Plan?           @relation("CustomerPlan", fields: [planId, tenantId], references: [id, tenantId], onDelete: Restrict)
  subscriptions  Subscription[]
  invoices       Invoice[]
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(6)

  @@unique([id, tenantId])
  @@unique([tenantId, customerNumber])
  @@index([tenantId, phone])
  @@index([tenantId, status])
  @@map("customers")
}

enum CustomerStatus {
  ACTIVE
  SUSPENDED
  PENDING
  TERMINATED
}

enum ConnectionType {
  PPPOE
  HOTSPOT
  STATIC
}

model Plan {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @db.Uuid
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  price         Decimal        @db.Decimal(12, 2)
  currency      String         @default("KES") @db.VarChar(3)
  downloadKbps  Int
  uploadKbps    Int
  durationDays  Int
  isActive      Boolean        @default(true)
  customers     Customer[]     @relation("CustomerPlan")
  subscriptions Subscription[]
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(6)

  @@unique([id, tenantId])
  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("plans")
}

model Subscription {
  id            String             @id @default(uuid()) @db.Uuid
  tenantId      String             @db.Uuid
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId    String             @db.Uuid
  customer      Customer           @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  planId        String             @db.Uuid
  plan          Plan               @relation(fields: [planId, tenantId], references: [id, tenantId], onDelete: Restrict)
  status        SubscriptionStatus @default(PENDING)
  startsAt      DateTime?          @db.Timestamptz(6)
  expiresAt     DateTime?          @db.Timestamptz(6)
  nextBillingAt DateTime?          @db.Timestamptz(6)
  createdAt     DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(6)

  @@unique([id, tenantId])
  @@index([tenantId, customerId, status])
  @@index([tenantId, expiresAt])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
}

model Router {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @db.Uuid
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                String
  vendor              String?
  model               String?
  ipAddress           String
  apiPort             Int       @default(8728)
  username            String
  credentialSecretRef String?
  isActive            Boolean   @default(true)
  lastSeenAt          DateTime? @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(6)

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("routers")
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @db.Uuid
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId    String        @db.Uuid
  customer      Customer      @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  invoiceNumber String
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("KES") @db.VarChar(3)
  status        InvoiceStatus @default(UNPAID)
  dueDate       DateTime      @db.Timestamptz(6)
  transactions  Transaction[]
  createdAt     DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(6)

  @@unique([id, tenantId])
  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, customerId, status])
  @@index([tenantId, dueDate])
  @@map("invoices")
}

enum InvoiceStatus {
  PAID
  UNPAID
  OVERDUE
  VOID
}

model Transaction {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String            @db.Uuid
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId         String?           @db.Uuid
  invoice           Invoice?          @relation(fields: [invoiceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  amount            Decimal           @db.Decimal(12, 2)
  currency          String            @default("KES") @db.VarChar(3)
  provider          String            @default("MPESA")
  providerReference String?
  phoneNumber       String
  mpesaReceipt      String?
  status            TransactionStatus @default(PENDING)
  createdAt         DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(6)

  @@unique([tenantId, provider, providerReference])
  @@unique([tenantId, mpesaReceipt])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, phoneNumber])
  @@map("transactions")
}

enum TransactionStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REVERSED
}


model AccountingConnection {
  id                     String   @id @default(uuid()) @db.Uuid
  tenantId               String   @db.Uuid
  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectedByUserId      String?  @db.Uuid
  connectedBy            User?    @relation("AccountingConnectionActor", fields: [connectedByUserId, tenantId], references: [id, tenantId], onDelete: Restrict)
  provider               String   @db.VarChar(40)
  displayName            String   @db.VarChar(120)
  externalAccountId      String?  @db.VarChar(160)
  status                 String   @default("pending") @db.VarChar(24)
  accessTokenCiphertext  String?
  refreshTokenCiphertext String?
  tokenExpiresAt         DateTime? @db.Timestamptz(6)
  grantedScopes          Json?
  settings               Json?
  lastSyncedAt           DateTime? @db.Timestamptz(6)
  createdAt              DateTime @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @db.Timestamptz(6)
  mappings               AccountingAccountMapping[]
  syncRuns               AccountingSyncRun[]
  syncItems              AccountingSyncItem[]

  @@unique([id, tenantId])
  @@unique([tenantId, provider, externalAccountId])
  @@index([tenantId, status])
  @@map("accounting_connections")
}

model AccountingAccountMapping {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @db.Uuid
  connectionId          String   @db.Uuid
  connection            AccountingConnection @relation(fields: [connectionId, tenantId], references: [id, tenantId], onDelete: Cascade)
  mappingType           String   @db.VarChar(40)
  localCode             String   @db.VarChar(80)
  externalAccountId     String   @db.VarChar(160)
  externalAccountName   String?  @db.VarChar(160)
  enabled               Boolean  @default(true)
  createdAt             DateTime @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @db.Timestamptz(6)

  @@unique([connectionId, mappingType, localCode])
  @@index([tenantId, connectionId])
  @@map("accounting_account_mappings")
}

model AccountingSyncRun {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectionId    String   @db.Uuid
  connection      AccountingConnection @relation(fields: [connectionId, tenantId], references: [id, tenantId], onDelete: Restrict)
  startedByUserId String?  @db.Uuid
  startedBy       User?    @relation("AccountingSyncActor", fields: [startedByUserId, tenantId], references: [id, tenantId], onDelete: Restrict)
  direction       String   @default("export") @db.VarChar(16)
  status          String   @default("queued") @db.VarChar(24)
  itemsTotal      Int      @default(0)
  itemsSucceeded  Int      @default(0)
  itemsFailed     Int      @default(0)
  summary         Json?
  startedAt       DateTime? @db.Timestamptz(6)
  finishedAt      DateTime? @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)
  items           AccountingSyncItem[]

  @@unique([id, tenantId])
  @@index([tenantId, createdAt])
  @@map("accounting_sync_runs")
}

model AccountingSyncItem {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  connectionId   String   @db.Uuid
  connection     AccountingConnection @relation(fields: [connectionId, tenantId], references: [id, tenantId], onDelete: Restrict)
  runId          String?  @db.Uuid
  run            AccountingSyncRun? @relation(fields: [runId, tenantId], references: [id, tenantId], onDelete: Restrict)
  localType      String   @db.VarChar(80)
  localId        String   @db.Uuid
  operation      String   @default("upsert") @db.VarChar(24)
  idempotencyKey String   @db.VarChar(190)
  payloadHash    String   @db.Char(64)
  externalId     String?  @db.VarChar(190)
  status         String   @default("queued") @db.VarChar(24)
  attempts       Int      @default(0)
  lastError      String?
  syncedAt       DateTime? @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  @@unique([tenantId, connectionId, idempotencyKey])
  @@index([tenantId, localType, localId])
  @@map("accounting_sync_items")
}
